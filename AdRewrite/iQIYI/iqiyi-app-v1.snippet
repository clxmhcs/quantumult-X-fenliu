# iQIYI App ad filtering - v1
# Based on 2026-09-02 iqiyi.har
#
# 1) Cupid mixer: splash ads, future pre-cache, masthead, Banner, and other direct ad slots
# 2) qy_home: home-page focus images, carousel/feed ads, and waterfall ad blocks
# 3) video_feed: native ads in the video feed
#
# Important: kjp.cupid.iqiyi.com / t7z.cupid.iqiyi.com must be allowed to return responses.
# Do not simultaneously apply a DOMAIN-SUFFIX REJECT rule to them, or script-response-body
# will not be able to run.

^https?:\/\/(?:kjp|t7z)\.cupid\.iqiyi\.com\/mixer(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/iQIYI/iqiyi-app-json-v1.js
^https?:\/\/cards\.iqiyi\.com\/views_home\/3\.0\/qy_home(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/iQIYI/iqiyi-app-json-v1.js
^https?:\/\/iface2\.iqiyi\.com\/video_feed\/3\.0\/feed(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/iQIYI/iqiyi-app-json-v1.js

hostname = kjp.cupid.iqiyi.com, t7z.cupid.iqiyi.com, cards.iqiyi.com, iface2.iqiyi.com
