# Tencent Video IACC JceGodId=63743 isolation test - v1
# Based on 2026-09-04 腾讯2.har + 1606.log
#
# EXPERIMENT ONLY.
#
# This script passes through every iacc.qq.com response except requests whose
# JceGodId header is exactly 63743. That response is replaced with HTTP 204.
#
# Test conditions:
#   1) Keep tencent-video-mvl-v1.snippet enabled.
#   2) Disable tencent-video-iacc-probe-v1.snippet during this test.
#   3) Disable tencent-video-pgdt-cache-test-v1.snippet.
#   4) Keep Advertising.list disabled so 63743 is the only new variable.
#   5) Do NOT clear Tencent Video cache and do NOT reinstall the app.
#
# Expected log when the target is hit:
#   TencentVideo-IACC63743: BLOCK target=63743 ...

^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/TencentVideo/tencent-video-iacc-63743-test-v1.js

hostname = iacc.qq.com
