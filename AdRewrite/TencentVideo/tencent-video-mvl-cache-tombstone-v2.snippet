# Tencent Video MVL cache tombstone experiment - v2
# Based on 2026-09-04 腾讯1/腾讯2/腾讯3 HAR experiments
#
# EXPERIMENT ONLY.
#
# Purpose:
#   Preserve ad_block/mod_adfeed module shells while removing nested ad payloads,
#   to test whether Tencent Video will overwrite persistent cached ad slots with
#   an explicit empty/tombstoned module instead of continuing to reuse old ads.
#
# Test conditions:
#   1) Disable tencent-video-mvl-v1.snippet. Do NOT enable v1 and v2 together.
#   2) Enable ONLY this v2 for i.video.qq.com.
#   3) Disable tencent-video-iacc-63743-test-v1.snippet.
#   4) Disable tencent-video-iacc-probe-v1.snippet for this single-variable test.
#   5) Keep Advertising.list disabled.
#   6) Do NOT clear Tencent Video cache and do NOT reinstall the app.
#
# Expected key log:
#   TencentVideo-Tombstone: preserved hardShells=... nativeShells=... tombstoned=...
#
# Interpretation:
#   - cached ad cards disappear after one or more MVL refreshes -> shell overwrite hypothesis supported
#   - ads remain unchanged -> remaining ads are likely outside MVL persistent module cache

^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/TencentVideo/tencent-video-mvl-cache-tombstone-v2.js

hostname = i.video.qq.com
