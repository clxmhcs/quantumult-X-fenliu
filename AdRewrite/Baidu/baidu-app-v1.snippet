# Baidu main App ad filtering - v1 experimental rewrite
# Scope:
# 1) Modify AFD remote ad-control configuration to disable search / Feed / selected splash-ad capabilities.
# 2) Apply request-side + response-side sanitization to splash cmd=2010:
#    - Request side: clear adinfo.s / adinfo.d / final_backup_key to weaken local cached-ad fallback.
#    - Response side: clear live splash-ad data.mt / data.ukey / final_backup_realtime_info.
# 3) Precisely reject splash_*.mp4 assets under search-splash.cdn.bcebos.com.
# 4) Persistently record suspected splash prefetch/asset requests and automatically print recent candidate history on each splash launch.
# 5) Search-ad source: directly handle the application/x-protobuffer main search response from m.baidu.com/s,
#    removing ec_r_* -> ec_wise_ad ad HTML with equal-length replacement before the first SP-engine render without changing Protobuf/frame length.
# 6) Keep wiseSearchHasAd only as the final fallback for search ads not covered by upstream structures.
# 7) Search diagnostics: at runtime, wiseSearchHasAd sends counts for t / ec_wise_ad / ec_r_* / dynamic i[]
#    to same-origin __qx_baidu_search_diag; QX intercepts it locally with HTTP 204 and does not forward it to Baidu.
# 8) Search lifecycle diagnostics: record /s request start and wiseSearchHasAd request start for comparison with proto-response completion time.
# 9) Secondary search-entry diagnostics: /searchbox investigation is complete; cmd=169 has been ruled out as the current main ad source; stop the general deep body probe.
# 10) ECOM prefetch/prerender diagnostics: target ldy_ajax_prefetch_flag / imlp_prerender, recording module request timing and
#     runtime counts for resultClass / selected commercial data-srcid / ec_wise_ad / ec_r_* without recording keywords or landing-page URLs.
# 11) Search-container diagnostics: target responses from m.baidu.com/searchframe and /sf, recording only lengths and ad-structure markers.
#
# Temporary single-variable experiment (2026-08-31): directly REJECT the main m.baidu.com/s search request.
# Confirmed result: ads still appear briefly and then disappear after /s is hard-rejected, so keep the hard reject while locating the preload/prerender path.
#
# Note: this is an experimental v1 and only handles confirmed structures or low-risk candidate paths.
# The splash MP4 rule matches only the dedicated search-splash host + splash_*.mp4 and does not expand to a blanket bcebos.com REJECT.
# The search Protobuf cleaner uses fail-open + equal-length replacement with safety thresholds for ad-block count/coverage ratio.

^https:\/\/afdconf\.baidu\.com\/afd\/platform(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-json-v1.js
^https?:\/\/mbd\.baidu\.com\/searchbox\?(?=(?:[^&]*&)*action=splash(?:&|$))(?=(?:[^&]*&)*cmd=2010(?:&|$)).* url script-request-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-splash-request-v1.js
^https?:\/\/mbd\.baidu\.com\/searchbox\?(?=(?:[^&]*&)*action=splash(?:&|$))(?=(?:[^&]*&)*cmd=2010(?:&|$)).* url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-json-v1.js
^https?:\/\/search-splash\.cdn\.bcebos\.com\/splash_[^?]*\.mp4(?:\?.*)?$ url reject

# Persistent splash pre-cache/fallback probe: record URL structure only; do not record query values, Cookie, or Token.
^https?:\/\/ecmb\.bdimg\.com(?::\d+)?\/.*(?:splash|launch|open[_-]?screen|preload|advert|\.mp4)(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-splash-cache-probe-v2.js
^https?:\/\/[^\/]+\.jomoxc\.com(?::\d+)?\/.*(?:splash|launch|open[_-]?screen|preload|advert|\.mp4)(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-splash-cache-probe-v2.js
^https?:\/\/mobads\.baidu\.com(?::\d+)?\/.*$ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-splash-cache-probe-v2.js
^https?:\/\/baichuan\.baidu\.com\/rs\/adpmobile\/launch(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-splash-cache-probe-v2.js
^https?:\/\/cover\.baidu\.com\/cover\/page\/dspSwitchAds\/(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-splash-cache-probe-v2.js
^https?:\/\/afd\.baidu\.com\/afd\/entry(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-splash-cache-probe-v2.js
^https?:\/\/mbd\.baidu\.com\/searchbox\?(?=(?:[^&]*&)*action=(?:preload|launch)(?:&|$)).* url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-splash-cache-probe-v2.js

# Temporary single-variable experiment: completely block the current m.baidu.com/s main search request.
# Verified: ads still appear briefly and then disappear after /s is cut off, so the first-frame ad does not depend on the current /s request.
^https:\/\/m\.baidu\.com\/s\?.* url reject

# Search-container /sf targeted diagnostics: read-only request lifecycle and response structure; do not modify the body.
^https:\/\/m\.baidu\.com\/(?:searchframe|sf)(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search-frame-probe-v1.js
^https:\/\/m\.baidu\.com\/(?:searchframe|sf)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search-frame-probe-v1.js

# Secondary search-entry header probe: exclude /s, the local diagnostic beacon, searchframe, sf, and /searchbox on mbd/h2mbd.
# /searchbox analysis is complete; searchframe/sf are handled by the dedicated body probe above to avoid header/body overlap.
^https:\/\/m\.baidu\.com\/(?!(?:s(?:\?|$)|searchframe(?:\?|$)|sf(?:\?|$)|__qx_baidu_search_diag(?:\?|$))).* url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js
^https:\/\/m\.baidu\.com\/(?!(?:s(?:\?|$)|searchframe(?:\?|$)|sf(?:\?|$)|__qx_baidu_search_diag(?:\?|$))).* url script-response-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js
^https:\/\/(?:mbd|h2mbd)\.baidu\.com\/(?!searchbox(?:\?|$)).* url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js
^https:\/\/(?:mbd|h2mbd)\.baidu\.com\/(?!searchbox(?:\?|$)).* url script-response-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js
^https:\/\/www\.baidu\.com\/.* url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js
^https:\/\/www\.baidu\.com\/.* url script-response-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js

# Search runtime diagnostics: the page emits only a local diagnostic beacon; QX prints it and returns 204 without sending it upstream to Baidu.
^https:\/\/m\.baidu\.com\/__qx_baidu_search_diag(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js

# ECOM request-timing diagnostics.
^https:\/\/nv00\.cdn\.bcebos\.com\/nv01\/static\/ecom\/amd\/wiseSearchHasAd-.*-chunk\.js url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js

# ECOM prefetch/prerender modules: record request timing and runtime counts of existing commercial-result DOM nodes.
^https:\/\/nv00\.cdn\.bcebos\.com\/nv01\/static\/ecom\/amd\/(?:ldy_ajax_prefetch_flag|imlp_prerender)-.*-chunk\.js url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search-prerender-probe-v1.js
^https:\/\/nv00\.cdn\.bcebos\.com\/nv01\/static\/ecom\/amd\/(?:ldy_ajax_prefetch_flag|imlp_prerender)-.*-chunk\.js url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search-prerender-probe-v1.js

# Final search-ad fallback: wiseSearchHasAd uses Baidu's native t selector / i[] to clean ad cards already inserted into the page.
^https:\/\/nv00\.cdn\.bcebos\.com\/nv01\/static\/ecom\/amd\/wiseSearchHasAd-.*-chunk\.js url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/AdRewrite/Baidu/baidu-app-search.js

hostname = afdconf.baidu.com, mbd.baidu.com, h2mbd.baidu.com, www.baidu.com, m.baidu.com, search-splash.cdn.bcebos.com, ecmb.bdimg.com, *.jomoxc.com, mobads.baidu.com, baichuan.baidu.com, cover.baidu.com, afd.baidu.com, nv00.cdn.bcebos.com