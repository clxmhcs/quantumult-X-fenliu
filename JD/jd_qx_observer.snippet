; JD Global Discovery Observer for Quantumult X
; TEMPORARY diagnostic resource.
; Import this file as a Rewrite remote resource.
; Do NOT import jd_qx_observer.js directly as a resource.
;
; Purpose: discover non-*.jd.com hosts used by JD App search.
; The JS logs metadata only for requests that look like JD App traffic.
; It does NOT log request/response bodies.
; Disable this resource after the diagnostic run.

hostname = *

; Global HTTPS discovery - four hooks so bodyless requests are not missed.
^https?:\/\/ url script-request-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/JD/jd_qx_observer.js
^https?:\/\/ url script-request-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/JD/jd_qx_observer.js
^https?:\/\/ url script-response-header https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/JD/jd_qx_observer.js
^https?:\/\/ url script-response-body https://raw.githubusercontent.com/clxmhcs/quantumult-X-fenliu/main/JD/jd_qx_observer.js
